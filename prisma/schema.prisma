// Prisma schema for the UGOCHUKWU CHUKWU CHRISTIAN portfolio + admin dashboard.
// Datasource: PostgreSQL (Supabase). Run `npx prisma migrate dev` after setting DATABASE_URL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A single admin account (the site owner). Seeded via prisma/seed.ts.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Portfolio project shown on the Portfolio page.
model Project {
  id          String   @id @default(cuid())
  name        String
  summary     String
  liveUrl     String?
  techStack   String[] // e.g. ["Next.js", "Tailwind", "Postgres"]
  imageUrl    String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Showcase details (all optional; empty falls back to src/lib/projects.ts).
  /// Hidden projects stay in the admin but never appear on the public site.
  published      Boolean  @default(true)
  category       String?
  /// One-sentence description for cards.
  lead           String?
  /// The problem the website addresses.
  challenge      String?
  solution       String?
  features       String[] @default([])
  /// Extra screenshots of the actual project.
  galleryUrls    String[] @default([])
  /// Key of a pricing package (src/lib/pricing.ts) used for the estimate.
  pricingPackage String?
  /// Optional custom estimate in whole naira; never below the ₦150,000 floor.
  priceMinNaira  Int?
  priceMaxNaira  Int?
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Client review submitted publicly, moderated by the admin.
model Review {
  id         String       @id @default(cuid())
  clientName String
  /// Job title / role (e.g. "CEO", "Marketing Manager"), required for new
  /// submissions via the public form. Nullable at the DB level only so
  /// reviews submitted before this field existed remain valid.
  position   String?
  rating     Int // 1-5
  message    String
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

/// Sitewide announcement banner.
model Announcement {
  id        String   @id @default(cuid())
  message   String
  isActive  Boolean  @default(true)
  startsAt  DateTime @default(now())
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A service booking / inquiry lead captured from the popup form.
model Booking {
  id          String   @id @default(cuid())
  clientName  String
  budget      String
  projectType String // service name, auto-prefilled from the clicked service card
  details     String
  whatsappUrl String
  createdAt   DateTime @default(now())

  // Extra fields from the "Discuss a similar project" form (optional, so
  // leads from the original booking form remain valid).
  /// "booking" | "project-inquiry"
  source               String  @default("booking")
  email                String?
  phone                String?
  deadline             String?
  features             String?
  /// Name of the project the visitor was viewing.
  sourceProject        String?
  /// Visitor confirmed they understand prices shown are estimates.
  estimateAcknowledged Boolean @default(false)
}

/// Singleton row (id = "singleton") holding global, admin-editable site settings
/// and editable site copy (hero tagline, bio, contact info).
model SiteSettings {
  id                  String   @id @default("singleton")
  reviewsSectionShown Boolean  @default(true)

  // Editable site content
  availabilityStatus  String   @default("Open for New Projects")
  heroIntro           String   @default("I'm Ugochukwu Chukwu Christian, a full-stack developer helping businesses grow their online presence with fast, modern websites, dashboards, e-commerce stores, and SaaS platforms that actually convert.")
  aboutBio            String   @default("I'm a full-stack web developer who helps businesses grow their online presence — building fast, modern websites, SaaS dashboards, e-commerce platforms, and APIs — end to end. From the first line of frontend code to the database schema powering it, I care about the details that make software feel solid: clean architecture, thoughtful UX, and code that doesn't fall apart six months after launch.\n\nWhether you need a marketing site, a full e-commerce store, or a custom SaaS platform with dashboards and auth, I work directly with you — no account managers, no middlemen — from planning through to launch.\n\nMy approach is simple: understand the problem before writing code, keep you informed at every stage, and ship something you can confidently hand off to any other developer later — well-structured, documented, and free of vendor lock-in.")
  contactEmail        String   @default("elitetechsolutions607@gmail.com")
  whatsappNumber      String   @default("2349065606430")

  // Branding
  siteName            String   @default("Ugochukwu Chukwu Christian")
  siteTagline         String   @default("Full-Stack Web Developer")
  siteDescription     String   @default("Full-stack web developer building fast, modern websites, SaaS dashboards, e-commerce platforms, and APIs.")
  heroHeadline         String  @default("Building fast, modern web experiences that work.")
  footerBio            String  @default("Ugochukwu Chukwu Christian — full-stack web developer building fast, modern websites, dashboards, and platforms.")

  // Stat overrides — null means "use the live computed value" (real project
  // count, real review count/average, etc.). Only set these when there's a
  // real number to report that isn't derivable by counting this site's own
  // database rows.
  projectsDeliveredOverride Int?
  clientReviewsOverride     Int?
  serviceCategoriesOverride Int?
  averageRatingOverride     Float?

  // Pricing (edited on Admin → Pricing). Null = the defaults in
  // src/lib/pricing.ts. The disclaimer is shown on /work, every case study
  // and /pricing.
  pricingDisclaimer         String?
  pricingConfig             Json?

  updatedAt           DateTime @updatedAt
}

/// FAQ entry shown on the About page.
model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A step in the "How I Work" process grid (Home + About).
model ProcessStep {
  id          String   @id @default(cuid())
  title       String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A category of services on the Services page (e.g. "Frontend Development").
model ServiceCategory {
  id          String    @id @default(cuid())
  title       String
  description String
  /// One of a fixed icon-name whitelist enforced in src/lib/validations.ts —
  /// must stay in sync with SERVICE_ICONS in src/lib/service-icons.ts.
  icon        String    @default("code")
  order       Int       @default(0)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// An individual bookable service within a ServiceCategory.
model Service {
  id          String          @id @default(cuid())
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  description String
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId])
}

/// Fixed-window rate limit counter, keyed by "route:ip". DB-backed rather
/// than in-memory since serverless deployments (Vercel) don't guarantee
/// shared memory across invocations the way a persistent server does.
model RateLimitBucket {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime
}

enum AnalyticsEventType {
  PAGE_VIEW
  BOOKING_CLICK
}

/// Lightweight first-party analytics — one row per tracked event.
model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  path      String?
  createdAt DateTime           @default(now())

  @@index([type, createdAt])
}

// ---------------------------------------------------------------------------
// Client acquisition (prospecting CRM). Written by the Python "prospector"
// service (prospector/) and read by the admin dashboard. Prisma owns the
// schema and migrations for both.
// ---------------------------------------------------------------------------

enum ProspectStage {
  DISCOVERED
  NEEDS_REVIEW
  QUALIFIED
  READY_FOR_OUTREACH
  CONTACTED
  REPLIED
  CONSULTATION_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  DO_NOT_CONTACT
}

/// Evidence-based website status. NONE_FOUND only ever means "not found in
/// the sources checked", never "this business has no website".
enum WebsiteStatus {
  UNCHECKED
  VERIFIED
  FOUND_UNVERIFIED
  NONE_FOUND
  UNCERTAIN
}

/// A business that might need my services, from a public source, a manual
/// entry, a CSV import or an inbound request.
model Prospect {
  id                 String        @id @default(cuid())
  businessName       String
  /// Lowercased, punctuation-free name; with city, the fuzzy dedupe key.
  normalizedName     String
  category           String?
  industry           String?
  address            String?
  city               String?
  state              String?
  country            String        @default("Nigeria")
  latitude           Float?
  longitude          Float?
  website            String?
  websiteDomain      String?
  websiteStatus      WebsiteStatus @default(UNCHECKED)
  websiteCheckedAt   DateTime?
  websiteEvidence    String?
  /// Public business contact channels only, as published by the source.
  email              String?
  phone              String?
  /// "openstreetmap" | "manual" | "csv" | "inbound"
  source             String
  sourceRef          String?
  sourceUrl          String?
  sourceLicense      String?
  discoveredAt       DateTime      @default(now())
  discoveryJobId     String?
  stage              ProspectStage @default(DISCOVERED)
  /// 0 normal, 1 high, 2 urgent
  priority           Int           @default(0)
  score              Int?
  scoreBreakdown     Json?
  scoreOverride      Int?
  qualification      String?
  recommendedService String?
  nextAction         String?
  scoredAt           DateTime?
  followUpAt         DateTime?
  proposalAmount     Int?
  wonAmount          Int?
  outcomeReason      String?
  doNotContact       Boolean       @default(false)
  archivedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  audits    ProspectAudit[]
  notes     ProspectNote[]
  events    ProspectEvent[]
  drafts    OutreachDraft[]
  followUps FollowUpTask[]

  @@unique([source, sourceRef])
  @@index([websiteDomain])
  @@index([normalizedName, city])
  @@index([stage])
  @@index([score])
  @@index([followUpAt])
  @@index([discoveredAt])
}

/// One website audit run. `findings` holds per-check results with evidence;
/// checks that couldn't run are recorded as "unavailable", never guessed.
model ProspectAudit {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  url        String
  finalUrl   String?
  /// "completed" | "partial" | "failed"
  status     String
  httpStatus Int?
  responseMs Int?
  pageBytes  Int?
  findings   Json
  pagespeed  Json?
  error      String?
  createdAt  DateTime @default(now())

  @@index([prospectId, createdAt])
}

model ProspectNote {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime @default(now())

  @@index([prospectId, createdAt])
}

/// Interaction history: outreach logged, replies, calls, stage changes…
model ProspectEvent {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type       String
  channel    String?
  summary    String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([prospectId, createdAt])
  @@index([type, createdAt])
}

model OutreachDraft {
  id         String    @id @default(cuid())
  prospectId String
  prospect   Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  template   String
  /// "email" | "whatsapp" | "phone" | "other"
  channel    String
  subject    String?
  body       String
  /// "draft" | "approved" | "rejected" | "sent"
  status     String    @default("draft")
  /// The verified facts the draft was built from.
  facts      Json?
  approvedAt DateTime?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([prospectId])
}

model FollowUpTask {
  id          String    @id @default(cuid())
  prospectId  String
  prospect    Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  title       String
  dueAt       DateTime
  /// "open" | "done" | "skipped"
  status      String    @default("open")
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, dueAt])
  @@index([prospectId])
}

/// Background work (discovery, audits, scoring…) processed in bounded steps
/// with a lease, so serverless invocations never overlap on the same job.
model ProspectJob {
  id             String    @id @default(cuid())
  type           String
  /// "queued" | "running" | "done" | "failed" | "cancelled"
  status         String    @default("queued")
  params         Json
  state          Json?
  total          Int?
  processed      Int       @default(0)
  attempts       Int       @default(0)
  leaseUntil     DateTime?
  idempotencyKey String?   @unique
  error          String?
  log            Json?
  createdBy      String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  @@index([status, createdAt])
}

/// Never-contact list, checked before any outreach is drafted or logged.
model Suppression {
  id        String   @id @default(cuid())
  /// "email" | "phone" | "domain"
  kind      String
  value     String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([kind, value])
}

model ProspectorSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Per-provider daily request counters for usage limits.
model UsageCounter {
  provider String
  day      DateTime @db.Date
  count    Int      @default(0)

  @@id([provider, day])
}

/// Record of admin actions on prospect data (edits, exports, deletions).
model AdminAuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Business records: paying clients, their projects, payments and expenses.
// All money is stored as whole kobo (₦1 = 100 kobo) in BigInt columns, so
// sums are exact. Totals are always computed from these rows; nothing
// stores a running balance that could drift.

enum ClientProjectStatus {
  INQUIRY
  QUOTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

/// "PROJECT" payments count toward the agreed price; "MAINTENANCE" covers
/// hosting / maintenance fees and is income, but doesn't reduce the balance.
enum ClientPaymentKind {
  PROJECT
  MAINTENANCE
}

model Client {
  id           String          @id @default(cuid())
  name         String
  businessName String?
  phone        String?
  email        String?
  whatsapp     String?
  notes        String?
  /// Set when converted from a prospect in the client-acquisition CRM.
  prospectId   String?
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  projects ClientProject[]
  payments ClientPayment[]
  expenses Expense[]

  @@index([deletedAt, createdAt])
  @@index([name])
}

model ClientProject {
  id                    String              @id @default(cuid())
  clientId              String
  client                Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title                 String
  /// Type of website or service, e.g. "E-commerce website".
  serviceType           String?
  description           String?
  priceKobo             BigInt?
  status                ClientProjectStatus @default(INQUIRY)
  startDate             DateTime?           @db.Date
  expectedDeliveryDate  DateTime?           @db.Date
  completedDate         DateTime?           @db.Date
  maintenanceFeeKobo    BigInt?
  /// "monthly" | "quarterly" | "yearly" | "one-off"
  maintenanceInterval   String?
  nextPaymentDate       DateTime?           @db.Date
  deletedAt             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  payments ClientPayment[]
  expenses Expense[]

  @@index([clientId])
  @@index([status, deletedAt])
  @@index([createdAt])
}

model ClientPayment {
  id              String            @id @default(cuid())
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId       String?
  project         ClientProject?    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  kind            ClientPaymentKind @default(PROJECT)
  amountKobo      BigInt
  paidOn          DateTime          @db.Date
  /// "bank_transfer" | "cash" | "card" | "pos" | "mobile_money" | "other"
  method          String
  reference       String?
  /// Generated by the form when it opens; makes double-submits harmless.
  clientRequestId String?           @unique
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([paidOn, deletedAt])
  @@index([clientId])
  @@index([projectId])
}

model Expense {
  id              String         @id @default(cuid())
  name            String
  amountKobo      BigInt
  category        String
  spentOn         DateTime       @db.Date
  notes           String?
  method          String?
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId       String?
  project         ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Path of a receipt in the private "receipts" storage bucket.
  receiptPath     String?
  clientRequestId String?        @unique
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([spentOn, deletedAt])
  @@index([category])
  @@index([projectId])
}
