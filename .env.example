# --- Database (Supabase Postgres) ---
# Pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection string (used by Prisma Migrate)
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Admin auth ---
# Seeded admin login (used by prisma/seed.ts). Change these before seeding in production.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-before-seeding"
# Long random string used to sign admin session JWTs. Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# --- Image uploads (Supabase Storage) ---
# Project URL and service role key from Supabase Dashboard > Project Settings > API.
# Used server-side only (never exposed to the browser) to upload project cover
# images to a public "project-images" storage bucket.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"

# --- WhatsApp booking redirect ---
# Digits only, no "+" or spaces, country code included. Exposed to the client
# bundle (NEXT_PUBLIC_) since the booking modal builds the wa.me link in-browser.
NEXT_PUBLIC_WHATSAPP_NUMBER="2349065606430"

# --- SEO ---
# Public URL the site is deployed at. Used for canonical links, the sitemap,
# robots.txt, and Open Graph tags. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
