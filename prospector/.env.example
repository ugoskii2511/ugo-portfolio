# Prospector service (deployed as its own Vercel project from prospector/).
# Placeholders only; set real values with `vercel env add`.

# Same Supabase Postgres as the website (pooled connection string).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Shared with the website's PROSPECTOR_API_SECRET.
PROSPECTOR_API_SECRET="generate-with-openssl-rand-base64-48"
# Vercel Cron sends this as a Bearer token.
CRON_SECRET="generate-with-openssl-rand-base64-32"
# Optional: Google PageSpeed Insights API key (free) for reliable speed tests.
PAGESPEED_API_KEY=""
# Linked in outreach drafts.
PORTFOLIO_URL="https://ugobuildsweb.name.ng"
# Automatic outreach email via Resend (all three needed; until then nothing is emailed).
RESEND_API_KEY="re_..."
# A sender on a domain verified in Resend.
OUTREACH_FROM="Your Name <hello@your-domain>"
# Signs unsubscribe links; the website needs the same value.
OUTREACH_SECRET="generate-with-openssl-rand-hex-32"
# Optional: where replies go (defaults to the site's contact email).
OUTREACH_REPLY_TO=""
