{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/main.py": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/cron/tick?slot=morning", "schedule": "0 6 * * *" },
    { "path": "/cron/tick?slot=midday", "schedule": "0 12 * * *" },
    { "path": "/cron/tick?slot=evening", "schedule": "0 18 * * *" },
    { "path": "/cron/daily", "schedule": "30 2 * * *" }
  ]
}
