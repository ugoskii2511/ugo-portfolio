{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": { "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [
    { "path": "/cron/tick?slot=morning", "schedule": "0 7 * * *" },
    { "path": "/cron/tick?slot=midday", "schedule": "0 12 * * *" },
    { "path": "/cron/tick?slot=evening", "schedule": "0 16 * * *" },
    { "path": "/cron/daily", "schedule": "30 2 * * *" }
  ]
}
